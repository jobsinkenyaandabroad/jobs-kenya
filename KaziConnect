          <div class="border-t border-slate-200 pt-2 flex justify-between text-sm font-black text-slate-900">
            <span>Total Payable via M-Pesa:</span>
            <span id="totalPayableText" class="text-emerald-700 text-base">KES 199</span>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitBtn" class="w-full bg-safaricom text-white font-black py-3.5 rounded-xl hover:bg-emerald-600 transition shadow-lg flex items-center justify-center gap-2 text-sm">
