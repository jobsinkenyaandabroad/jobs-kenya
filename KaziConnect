            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Upload Current CV (PDF or Word)</label>
          <input type="file" id="regCV" accept=".pdf,.doc,.docx" required class="w-full border border-slate-300 border-dashed rounded-lg p-3 text-xs text-slate-600 bg-slate-50 cursor-pointer">
          <p class="text-[10px] text-slate-400 mt-1">Accepted formats: .pdf, .docx, .doc (Max 5MB)</p>
        </div>

        <!-- The KES 300 CV Upsell Checkbox -->
        <div class="bg-amber-50 border border-amber-300 rounded-xl p-4 transition">
          <label class="flex items-start gap-3 cursor-pointer">
