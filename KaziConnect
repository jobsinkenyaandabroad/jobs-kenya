              <tr>
                <th class="p-3">Candidate</th>
                <th class="p-3">Field & Destination</th>
                <th class="p-3">Total Due</th>
                <th class="p-3">Status / Receipt</th>
                <th class="p-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="adminTableBody" class="divide-y divide-slate-100">
              <!-- Dynamically populated from localStorage -->
            </tbody>
          </table>
        </div>
