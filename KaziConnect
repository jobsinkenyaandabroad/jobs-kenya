        <!-- Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
            <div class="text-[10px] uppercase font-bold text-slate-500">Total Leads</div>
            <div class="text-xl font-black text-slate-900" id="adminTotalLeads">0</div>
          </div>
          <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-200">
            <div class="text-[10px] uppercase font-bold text-emerald-700">Verified Paid</div>
