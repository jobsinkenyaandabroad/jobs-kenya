              <option>Both Kenya & Abroad</option>
              <option>Europe / UK (Caregivers, Hospitality)</option>
              <option>Kenya Local Jobs Only</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Passport Status</label>
            <select id="regPassport" class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-emerald-600 outline-none bg-white">
              <option>Valid Kenyan Passport (Ready)</option>
              <option>Application in Progress</option>
              <option>No Passport (Kenya Local Only)</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Main Job Specialization</label>
            <select id="regField" class="w-full border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm focus:ring-2 focus:ring-emerald-600 outline-none bg-white">
