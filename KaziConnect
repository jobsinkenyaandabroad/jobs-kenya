            <p class="text-xs text-slate-500">M-Pesa: 0708 743 931 • WhatsApp Desk: 0739 658 520</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="exportCandidatesCSV()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-300 transition flex items-center gap-1.5">
              <i class="fas fa-file-csv text-emerald-700"></i> Export CSV
