  <!-- Admin Dashboard Modal (PIN: 7439) -->
  <div id="adminModal" class="fixed inset-0 bg-slate-950/80 z-50 flex items-center justify-center p-4 hidden backdrop-blur-sm">
    <div class="bg-white rounded-2xl max-w-4xl w-full p-6 max-h-[90vh] overflow-y-auto shadow-2xl space-y-5">
      <!-- Admin Login View -->
      <div id="adminLoginView" class="max-w-sm mx-auto text-center space-y-4 py-6">
