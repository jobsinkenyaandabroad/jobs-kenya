          </div>
          <div class="bg-amber-50 p-3 rounded-lg border border-amber-200">
            <div class="text-[10px] uppercase font-bold text-amber-700">CV Revamps</div>
            <div class="text-xl font-black text-amber-700" id="adminRevampLeads">0</div>
