  </div>

  <script>
    // Numbers Configuration
    const MPESA_PAYMENT_LINE = "0708 743 931";
    const WHATSAPP_DESK_NUMBER = "254739658520";
    const ADMIN_PASSCODE = "7439";

    let currentPayable = 199;

    // Toggle Fee Calculation
    function updateTotalPayable() {
      const isChecked = document.getElementById("cvUpsellCheckbox").checked;
      const upsellRow = document.getElementById("upsellSummaryRow");
      const totalText = document.getElementById("totalPayableText");

      if (isChecked) {
        currentPayable = 499;
        upsellRow.classList.remove("hidden");
        totalText.innerText = "KES 499";
      } else {
        currentPayable = 199;
        upsellRow.classList.add("hidden");
        totalText.innerText = "KES 199";
      }
    }

    // Role Quick Apply Button
    function applyForRole(roleName) {
      document.getElementById("regField").value = roleName;
      document.getElementById("register").scrollIntoView({ behavior: 'smooth' });
    }

    // Handle Form Submit
    function handleRegistrationSubmit(e) {
      e.preventDefault();

      const name = document.getElementById("regName").value;
      const phone = document.getElementById("regPhone").value;
      const dest = document.getElementById("regDest").value;
      const passport = document.getElementById("regPassport").value;
      const field = document.getElementById("regField").value;
      const cvInput = document.getElementById("regCV");
      const cvRevamp = document.getElementById("cvUpsellCheckbox").checked;
      const mpesaCode = document.getElementById("regMpesaCode").value.trim().toUpperCase() || "PENDING";

      const cvFileName = cvInput.files[0] ? cvInput.files[0].name : "cv_document.pdf";

      // Save to localStorage for Admin view
      const candidateRecord = {
        id: "CAN-" + Date.now().toString().slice(-6),
        name,
        phone,
        dest,
        passport,
        field,
        cvFileName,
        cvRevamp,
        mpesaCode,
        amount: currentPayable,
        status: mpesaCode !== "PENDING" ? "Submitted (Pending Check)" : "Payment Pending",
        date: new Date().toLocaleDateString("en-GB")
      };

      const existing = JSON.parse(localStorage.getItem("kazi_candidates") || "[]");
      existing.unshift(candidateRecord);
      localStorage.setItem("kazi_candidates", JSON.stringify(existing));

      // Display payment guidance alert
      const instructions = 
        `REGISTRATION RECEIVED!\n\n` +
        `Amount Payable: KES ${currentPayable}\n` +
        `1. Send KES ${currentPayable} to M-Pesa Line: ${MPESA_PAYMENT_LINE}\n` +
        `2. Click OK to open WhatsApp Desk (0739 658 520) to send your CV and M-Pesa code for instant verification.`;
      
      alert(instructions);

      // Redirect to WhatsApp Desk (0739 658 520)
      const waText = encodeURIComponent(
        `Hello Admin, I have submitted my registration details on the website.\n\n` +
        `• Name: ${name}\n` +
        `• Phone: ${phone}\n` +
        `• Target: ${field} (${dest})\n` +
        `• Total Due: KES ${currentPayable} (Payable to ${MPESA_PAYMENT_LINE})\n` +
        `• CV Revamp: ${cvRevamp ? 'YES (KES 300 included)' : 'NO'}\n` +
        `• M-Pesa Code: ${mpesaCode}\n\n` +
        `Attached is my current CV for verification.`
      );

      window.open(`https://wa.me/${WHATSAPP_DESK_NUMBER}?text=${waText}`, "_blank");
      document.getElementById("candidateForm").reset();
      updateTotalPayable();
    }

    // Filter Candidate Bank
    function filterCandidateBank() {
      const fieldFilter = document.getElementById("empFilterField").value;
      const passportFilter = document.getElementById("empFilterPassport").value;
      const cards = document.querySelectorAll(".candidate-card");

      cards.forEach(card => {
        const cardField = card.getAttribute("data-field");
        const cardPassport = card.getAttribute("data-passport");

        const matchesField = (fieldFilter === "all" || cardField === fieldFilter);
        const matchesPassport = (passportFilter === "all" || cardPassport === passportFilter);

        if (matchesField && matchesPassport) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    }

    // Standalone CV Revamp Modal (KES 300)
    function orderCVRevampOnly() {
      const confirmMsg = 
        `ORDER PROFESSIONAL CV REVAMP (KES 300):\n\n` +
        `1. Send KES 300 to M-Pesa line: ${MPESA_PAYMENT_LINE}\n` +
        `2. Click OK to open our WhatsApp Desk (0739 658 520) and send your current CV for review.`;
      
      if (confirm(confirmMsg)) {
        const text = encodeURIComponent(
          `Hello Admin, I want to order the KES 300 ATS CV Revamp.\n` +
          `I am sending payment to ${MPESA_PAYMENT_LINE}.\n` +
          `Here is my current CV and M-Pesa confirmation code:`
        );
        window.open(`https://wa.me/${WHATSAPP_DESK_NUMBER}?text=${text}`, "_blank");
      }
    }

    // Employer Pass Order (KES 1,000)
    function orderEmployerPass() {
      const confirmMsg = 
        `EMPLOYER 20-CV UNLOCK PASS (KES 1,000):\n\n` +
        `1. Send KES 1,000 to M-Pesa line: ${MPESA_PAYMENT_LINE}\n` +
        `2. Click OK to open our WhatsApp Desk (0739 658 520) to receive candidate access immediately.`;
      
      if (confirm(confirmMsg)) {
        const text = encodeURIComponent(
          `Hello Admin, I am an employer/agency seeking to unlock 20 candidate CVs for KES 1,000.\n` +
          `Payment sent to ${MPESA_PAYMENT_LINE}. Please provide access.`
        );
        window.open(`https://wa.me/${WHATSAPP_DESK_NUMBER}?text=${text}`, "_blank");
      }
    }

    // Admin Dashboard Logic
    function toggleAdminModal() {
      const modal = document.getElementById("adminModal");
      modal.classList.toggle("hidden");
    }

    function verifyAdminPIN() {
      const pin = document.getElementById("adminPinInput").value;
      if (pin === ADMIN_PASSCODE) {
        document.getElementById("adminLoginView").classList.add("hidden");
        document.getElementById("adminPanelView").classList.remove("hidden");
        loadAdminRecords();
      } else {
        document.getElementById("pinErrorMsg").classList.remove("hidden");
      }
    }

    function loadAdminRecords() {
      const candidates = JSON.parse(localStorage.getItem("kazi_candidates") || "[]");
      const tbody = document.getElementById("adminTableBody");
      
      let totalRev = 0;
      let paidCount = 0;
      let revampCount = 0;

      candidates.forEach(c => {
        if (c.status === "Verified Paid") {
          paidCount++;
          totalRev += Number(c.amount) || 199;
        }
        if (c.cvRevamp) revampCount++;
      });

      document.getElementById("adminTotalLeads").innerText = candidates.length;
      document.getElementById("adminPaidLeads").innerText = paidCount;
      document.getElementById("adminRevampLeads").innerText = revampCount;
      document.getElementById("adminTotalRev").innerText = "KES " + totalRev.toLocaleString();

      if (candidates.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-400">No candidates have registered yet. Submissions will appear here.</td></tr>`;
        return;
      }

      tbody.innerHTML = candidates.map((c, index) => {
        const isPaid = c.status === "Verified Paid";
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="p-3">
              <div class="font-bold text-slate-900">${c.name}</div>
              <div class="text-[10px] text-slate-500">${c.phone} • ${c.date}</div>
            </td>
            <td class="p-3">
              <div class="font-medium text-slate-800">${c.field}</div>
              <div class="text-[10px] text-slate-500">${c.dest} • ${c.passport}</div>
            </td>
            <td class="p-3 font-bold text-slate-900">
              KES ${c.amount}
              ${c.cvRevamp ? '<span class="block text-[9px] text-amber-700 font-black">+ CV REVAMP</span>' : ''}
            </td>
            <td class="p-3">
              <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                ${c.status}
              </span>
              ${c.mpesaCode ? `<div class="font-mono text-[9px] text-slate-500 mt-0.5 font-bold">${c.mpesaCode}</div>` : ''}
            </td>
            <td class="p-3 text-right space-x-1">
              <a href="https://wa.me/254${c.phone.replace(/[^0-9]/g, '').slice(-9)}" target="_blank" class="inline-block bg-emerald-600 text-white px-2 py-1 rounded text-[10px] font-bold hover:bg-emerald-700">
                <i class="fab fa-whatsapp"></i> Chat
              </a>
              ${!isPaid ? `
                <button onclick="markCandidatePaid(${index})" class="bg-slate-900 text-white px-2 py-1 rounded text-[10px] font-bold hover:bg-slate-800">
                  Verify Pay
                </button>
              ` : ''}
            </td>
          </tr>
        `;
      }).join('');
    }

    function markCandidatePaid(index) {
      const candidates = JSON.parse(localStorage.getItem("kazi_candidates") || "[]");
      if (candidates[index]) {
        candidates[index].status = "Verified Paid";
        localStorage.setItem("kazi_candidates", JSON.stringify(candidates));
        loadAdminRecords();
      }
    }

    // Export Leads as CSV
    function exportCandidatesCSV() {
      const candidates = JSON.parse(localStorage.getItem("kazi_candidates") || "[]");
      if (candidates.length === 0) {
        alert("No candidate data to export yet.");
        return;
      }

      let csv = "ID,Name,Phone,Target,Passport,Field,Amount,Status,M-Pesa Code,CV Revamp,Date\n";
      candidates.forEach(c => {
        csv += `"${c.id}","${c.name}","${c.phone}","${c.dest}","${c.passport}","${c.field}","${c.amount}","${c.status}","${c.mpesaCode || ''}","${c.cvRevamp ? 'Yes' : 'No'}","${c.date}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.setAttribute('hidden', '');
      a.setAttribute('href', url);
      a.setAttribute('download', `kazi_candidates_${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }
  </script>
